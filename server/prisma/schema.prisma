generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollegeStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum SubscriptionPlan {
  TRIAL
  BASIC
  STANDARD
  PREMIUM
}

enum ExamStatus {
  draft
  published
  ongoing
  completed
}

enum Gender {
  male
  female
  other
}

/// ─── TENANT (COLLEGE) ───────────────────────────────────────────────
model College {
  id                String            @id @default(uuid())
  name              String
  code              String            @unique // short slug, e.g. "svit2026"
  contactEmail      String
  contactPhone      String?

  adminEmail        String            @unique
  adminPasswordHash String

  plan              SubscriptionPlan  @default(TRIAL)
  status            CollegeStatus     @default(TRIAL)

  startDate         DateTime          @default(now())
  renewalDate       DateTime          // subscription valid until this date
  terminatedAt      DateTime?
  suspendedAt       DateTime?

  maxStudents       Int               @default(2000)
  maxRooms          Int               @default(50)
  maxFaculty        Int               @default(200)

  notes             String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  streams           Stream[]
  departments       Department[]
  branches          Branch[]
  students          Student[]
  faculty           Faculty[]
  rooms             Room[]
  exams             Exam[]
  shifts            Shift[]
  seatingAssignments      SeatingAssignment[]
  invigilatorAssignments  InvigilatorAssignment[]
  activityLogs      ActivityLog[]

  @@index([status])
  @@index([renewalDate])
}

/// ─── ACTIVITY LOG ───────────────────────────────────────────────────
model ActivityLog {
  id          String   @id @default(uuid())
  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  action      String
  entity      String
  entityId    String?
  description String?
  metadata    Json?
  performedAt DateTime @default(now())

  @@index([collegeId, performedAt])
}

/// ─── ACADEMIC STRUCTURE ─────────────────────────────────────────────
model Stream {
  id            String   @id @default(uuid())
  collegeId     String
  college       College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name          String
  code          String
  durationYears Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  departments   Department[]
  branches      Branch[]
  students      Student[]

  @@unique([collegeId, code])
  @@index([collegeId])
}

model Department {
  id        String   @id @default(uuid())
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name      String
  code      String
  streamId  String
  stream    Stream   @relation(fields: [streamId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  students  Student[]

  @@unique([collegeId, code])
  @@index([collegeId, streamId])
}

model Branch {
  id           String   @id @default(uuid())
  collegeId    String
  college      College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name         String
  code         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  streamId     String
  stream       Stream   @relation(fields: [streamId], references: [id])
  totalYears   Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students     Student[]

  @@unique([collegeId, code])
  @@index([collegeId, departmentId])
}

/// ─── PEOPLE ─────────────────────────────────────────────────────────
model Faculty {
  id            String   @id @default(uuid())
  collegeId     String
  college       College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name          String
  email         String
  employeeId    String
  departmentIds String[] // array of Department ids (no join table needed)
  designation   String
  phone         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invigilatorAssignments InvigilatorAssignment[]

  @@unique([collegeId, email])
  @@unique([collegeId, employeeId])
  @@index([collegeId])
}

model Student {
  id            String   @id @default(uuid())
  collegeId     String
  college       College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name          String
  email         String
  enrollmentNo  String
  streamId      String
  stream        Stream   @relation(fields: [streamId], references: [id])
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  year          Int
  gender        Gender   @default(other)
  phone         String?
  specialNeeds  Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seatingAssignments SeatingAssignment[]

  @@unique([collegeId, enrollmentNo])
  @@unique([collegeId, email])
  @@index([collegeId, branchId, year])
  @@index([collegeId, departmentId])
}

/// ─── ROOMS ──────────────────────────────────────────────────────────
model Room {
  id                   String   @id @default(uuid())
  collegeId            String
  college              College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name                 String
  building             String?
  floor                String?
  rows                 Int
  benchesPerRow        Int
  defaultSeatsPerBench Int
  hasCustomRowConfig   Boolean  @default(false)
  rowConfig            Json     @default("[]")
  seats                Json     @default("[]") // [{seatId,row,bench,position,status}]
  totalCapacity        Int      @default(0)
  usableCapacity       Int      @default(0)
  isLocked             Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  shiftRooms           ShiftRoom[]
  seatingAssignments   SeatingAssignment[]
  invigilatorAssignments InvigilatorAssignment[]

  @@unique([collegeId, name])
  @@index([collegeId, isActive])
}

/// ─── EXAMS / SHIFTS ─────────────────────────────────────────────────
model Exam {
  id           String     @id @default(uuid())
  collegeId    String
  college      College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  title        String
  academicYear String
  examDate     DateTime
  description  String?
  status       ExamStatus @default(draft)
  isLocked     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  shifts       Shift[]
  seatingAssignments     SeatingAssignment[]
  invigilatorAssignments InvigilatorAssignment[]

  @@index([collegeId, status])
  @@index([collegeId, examDate])
}

model Shift {
  id                  String   @id @default(uuid())
  collegeId           String
  college             College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  examId              String
  exam                Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  name                String
  startTime           String
  endTime             String
  selectedBranchIds   String[]
  selectedYears       Int[]
  studentIds          String[]
  totalStudents       Int      @default(0)
  totalAvailableSeats Int      @default(0)
  seatingRules        Json     @default("{}")
  planGenerated       Boolean  @default(false)
  planGeneratedAt     DateTime?
  isPublished         Boolean  @default(false)
  publishedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shiftRooms          ShiftRoom[]
  seatingAssignments  SeatingAssignment[]
  invigilatorAssignments InvigilatorAssignment[]

  @@index([collegeId, examId])
  @@unique([examId, name])
}

model ShiftRoom {
  id              String @id @default(uuid())
  shiftId         String
  shift           Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  roomId          String
  room            Room   @relation(fields: [roomId], references: [id])
  priority        Int    @default(0)
  usableCapacity  Int    @default(0)

  @@unique([shiftId, roomId])
  @@index([shiftId])
}

model SeatingAssignment {
  id               String   @id @default(uuid())
  collegeId        String
  college          College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  examId           String
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  shiftId          String
  shift            Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  roomId           String
  room             Room     @relation(fields: [roomId], references: [id])
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  seatId           String
  row              String
  bench            Int
  position         String
  isManualOverride Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shiftId, studentId])
  @@unique([shiftId, roomId, seatId])
  @@index([collegeId, examId, shiftId, roomId])
  @@index([studentId])
}

model InvigilatorAssignment {
  id         String   @id @default(uuid())
  collegeId  String
  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  facultyId  String
  faculty    Faculty  @relation(fields: [facultyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([shiftId, roomId, facultyId])
  @@index([shiftId, facultyId])
  @@index([facultyId])
}